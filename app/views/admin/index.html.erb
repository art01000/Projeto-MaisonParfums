<header>
  <nav>
    <ul>
      <li><%= link_to "Início", root_path %></li>
      <% if usuario_signed_in? %>
        <li><%= button_to "Sair", destroy_usuario_session_path, method: :delete %></li>
      <% end %>
      <li><%= link_to "Cadastrar Produtos", new_produto_path %></li>
    </ul>
  </nav>
</header>
<main class="container">
  <h1>Bem-vindo ao Painel Administrativo</h1>

  <div class="row">
    <!-- Usuários -->
    <div class="col-md-6">
      <div class="card text-white bg-primary mb-3 shadow">
        <div class="card-header">Usuários Cadastrados</div>
        <div class="card-body">
          <h2 class="card-title display-4"><%= @total_usuarios %></h2>
          <p class="card-text">Total de contas registradas na plataforma.</p>
        </div>
      </div>
    </div>

    <!-- Produtos -->
    <div class="col-md-6">
      <div class="card text-white bg-success mb-3 shadow">
        <div class="card-header">Produtos Cadastrados</div>
          <div class="card-body">
            <h2 class="card-title display-4"><%= @total_produtos %></h2>
            <p class="card-text">Total de itens disponíveis no catálogo.</p>
          </div>
        </div>
    </div>

    <!-- Pedidos -->
    <div class="card bg-info text-white mb-3">
      <div class="card-header">Total de Pedidos</div>
        <div class="card-body">
          <h2><%= @total_pedidos %></h2>
        </div>
      </div>
  </div>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Gerenciamento de Pedidos</h1>
      <%= link_to "Voltar ao Painel", admin_root_path, class: "btn btn-outline-secondary" %>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>Usuário</th>
            <th>Data do Pedido</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @pedidos.each_with_index do |pedido, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= pedido.usuario&.email || "Usuário não encontrado" %></td>
              <td><%= pedido.created_at.strftime("%d/%m/%Y às %H:%M") %></td>
              <td>
                <% 
                  badge_class = case pedido.status
                  when "pendente" then "bg-warning text-dark"
                  when "pago" then "bg-info text-dark"
                  when "enviado" then "bg-primary"
                  when "entregue" then "bg-success"
                  when "cancelado" then "bg-danger"
                  else "bg-secondary"
                  end
                %>
                <span class="badge <%= badge_class %>"><%= pedido.status.titleize %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</main>
